/bin/
/coverage.out

# Keys, secrets and credentials. The README's quick start creates keys/ in the repository root (agents/ holds only public bundles).
/keys/
*.identity.json
*.key
*.pem
*.p12
.env
.env.*
*.secret
alarm-secret*
*.token
*-sa.json
*sa-key*.json
*service-account*.json
application_default_credentials.json
client_secret*.json
credentials*.json

# Terraform: local state and plans name real resources; the provider cache is large. Commit .terraform.lock.hcl.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
crash.log

# Local state of a running agent and of the tools around it: nothing of it belongs in a commit.
/agents/
/state/
.petrvs-inbox/
*.log
.claude/
.DS_Store
.idea/
.vscode/
