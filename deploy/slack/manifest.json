{
  "display_information": {
    "description": "A bridge between this chat and a terminal assistant (Claude Code in tmux) on one machine.",
    "name": "petrvs-bridge"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "always_online": false,
      "display_name": "petrvs-bridge"
    },
    "slash_commands": [
      {
        "command": "/pb-status",
        "description": "Agents: online or offline, last heard",
        "should_escape": false
      },
      {
        "command": "/pb-agent",
        "description": "Choose which agent gets your text (buttons)",
        "should_escape": false
      },
      {
        "command": "/pb-enter",
        "description": "Press Enter in the session",
        "should_escape": false
      },
      {
        "command": "/pb-esc",
        "description": "Press Escape",
        "should_escape": false
      },
      {
        "command": "/pb-alarm",
        "description": "Alarm status; /pb-alarm on, /pb-alarm off [code]",
        "should_escape": false
      },
      {
        "command": "/pb-lockdown",
        "description": "Stop relaying and lock the agents until unlocked on their machine",
        "should_escape": false
      },
      {
        "command": "/pb-unlock",
        "description": "Relay again (locked agents stay locked)",
        "should_escape": false
      },
      {
        "command": "/pb-help",
        "description": "List of commands",
        "should_escape": false
      },
      {
        "command": "/pb-screen",
        "description": "Show the bottom of the session's screen, with buttons",
        "should_escape": false
      },
      {
        "command": "/pb-sessions",
        "description": "Ask Claude Code to list all its sessions",
        "should_escape": false
      },
      {
        "command": "/pb-stop",
        "description": "Interrupt Claude Code (presses Escape)",
        "should_escape": false
      },
      {
        "command": "/pb-agents",
        "description": "Agents: online or offline, last heard",
        "should_escape": false
      },
      {
        "command": "/pb-up",
        "description": "Press the Up arrow in the session",
        "should_escape": false
      },
      {
        "command": "/pb-down",
        "description": "Press the Down arrow in the session",
        "should_escape": false
      },
      {
        "command": "/pb-tab",
        "description": "Press Tab in the session",
        "should_escape": false
      },
      {
        "command": "/pb-key",
        "description": "Press a key by number or name: /pb-key 2, /pb-key btab",
        "should_escape": false
      },
      {
        "command": "/pb-clear",
        "description": "Clear the session: types Claude Code's own clear command",
        "should_escape": false
      },
      {
        "command": "/pb-compact",
        "description": "Compact the session: types Claude Code's own compact command",
        "should_escape": false
      },
      {
        "command": "/pb-resume",
        "description": "Resume an older session: types Claude Code's own resume command",
        "should_escape": false
      },
      {
        "command": "/pb-continue",
        "description": "Start Claude Code again on the machine; /pb-continue NAME for one agent",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands",
        "files:read",
        "files:write",
        "im:history",
        "im:write",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
