<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS: keeps the agent running and restarts it if it dies.
     Copy to ~/Library/LaunchAgents/, edit the paths, then: launchctl load ~/Library/LaunchAgents/com.example.claude-bridge-agent.plist
     Logs go to the files below; they never contain message text. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.claude-bridge-agent</string>
  <key>ProgramArguments</key>
  <array><string>/usr/local/bin/agent</string><string>run</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CB_NAME</key><string>laptop</string>
    <key>CB_PROJECT</key><string>YOUR_PROJECT</string>
    <key>CB_IDENTITY</key><string>/Users/YOU/.config/claude-bridge/laptop.identity.json</string>
    <key>CB_HUB_PUB</key><string>/Users/YOU/.config/claude-bridge/hub.pub.json</string>
    <key>CB_TMUX_SESSION</key><string>claude</string>
    <key>GOOGLE_APPLICATION_CREDENTIALS</key><string>/Users/YOU/.config/claude-bridge/agent-sa.json</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/Library/Logs/claude-bridge-agent.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/claude-bridge-agent.log</string>
</dict>
</plist>
